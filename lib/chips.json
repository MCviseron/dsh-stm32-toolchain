        }
      ],
      "maxBaud": 115200,
      "flashPage": 2048,
      "erase": "extended",
      "reset": "nrst"
    }
  },
  "devices": {
    "STM32F103C8": {
      "family": "STM32F1",
      "flash": "64K",
      "ram": "20K",
      "note": "Blue Pill. PA9/PA10 are usually tied to the on-board CH340; use USART3 or lift the CH340 TX when the ESP bridge shares the port."
    },
    "STM32F407VE": {
      "family": "STM32F4",
      "flash": "512K",
      "ram": "128K",
      "note": "USART3 PB10/PB11 avoids the on-board CH340 collision."
    },
    "STM32F411CE": {
      "family": "STM32F4",
      "flash": "512K",
      "ram": "128K",
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        },
        {
          "p": "USART2",
          "tx": "PA2",
          "rx": "PA3"
        },
        {
          "p": "USART6",
          "tx": "PC6",
          "rx": "PC7"
        }
      ],
      "note": "Black Pill F411: no USART3 - use USART1/2/6 for the bootloader bridge."
    }
  }
}
