        }
      ],
      "maxBaud": 115200,
      "flashPage": 2048,
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32L0": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        }
      ],
      "maxBaud": 115200,
      "flashPage": 128,
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32L1": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        }
      ],
      "maxBaud": 115200,
      "flashPage": 256,
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32L4": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
