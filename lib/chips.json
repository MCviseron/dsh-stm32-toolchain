{
  "version": 1,
  "note": "Bootloader facts follow AN2606/AN3155. Add boards under devices; add a family here when one is missing.",
  "families": {
    "STM32F0": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        }
      ],
      "maxBaud": 115200,
      "flashPage": 1024,
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32F1": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        }
      ],
      "maxBaud": 115200,
      "flashPage": 1024,
      "erase": "standard",
      "reset": "nrst"
    },
    "STM32F3": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        }
      ],
      "maxBaud": 115200,
      "flashPage": 2048,
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32F4": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        },
        {
          "p": "USART3",
          "tx": "PB10",
          "rx": "PB11"
        }
      ],
      "maxBaud": 115200,
      "flashPage": null,
      "sectors": "4x16K,1x64K,7x128K",
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32F7": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        },
        {
          "p": "USART3",
          "tx": "PB10",
          "rx": "PB11"
        }
      ],
      "maxBaud": 115200,
      "flashPage": null,
      "sectors": "4x32K,1x128K,3x256K",
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32G0": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        }
      ],
      "maxBaud": 115200,
      "flashPage": 2048,
      "erase": "extended",
      "reset": "nrst"
    },
    "STM32G4": {
      "uart": [
        {
          "p": "USART1",
          "tx": "PA9",
          "rx": "PA10"
        },
        {
          "p": "USART3",
