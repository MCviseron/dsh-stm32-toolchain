{
  "name": "dsh-stm32-toolchain",
  "version": "0.2.0",
  "description": "DSH plugin: Keil build, STM32CubeMX, serial monitor and flashing (ST-Link, UART bootloader, Wi-Fi bridge) in one panel",
  "license": "MIT",
  "author": {
    "name": "dsh-stm32-toolchain contributors"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "stm32",
    "keil",
    "uvision",
    "stm32cubemx",
    "embedded",
    "flashing",
    "an3155",
    "esp8266",
    "wifi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCviseron/dsh-stm32-toolchain.git"
  },
  "homepage": "https://github.com/MCviseron/dsh-stm32-toolchain#readme",
  "bugs": {
    "url": "https://github.com/MCviseron/dsh-stm32-toolchain/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./bridge": "./lib/bridge.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "firmware/esp01s/esp01s.ino",
    "firmware/esp01s/README.md",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "scripts": {
    "test": "node test/startup.test.mjs && node test/runtime.test.mjs && node test/settings.test.mjs && node test/env-check.test.mjs && node test/ui-contract.test.mjs && node test/client.test.mjs && node test/client-primitives.test.mjs && node test/jump.test.mjs && node test/vscode.test.mjs && node test/lease.test.mjs && node test/presentation.test.mjs && node test/paths.test.mjs && node test/no-project.test.mjs && node test/smoke.mjs && node test/wifi.test.mjs && node test/discover.test.mjs && node test/wifi-pipe.test.mjs && node test/erase.test.mjs && node test/sector-erase.test.mjs && node test/write-memory.test.mjs && node test/bridge.test.mjs",
    "doctor": "node test/doctor.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.2 || ^0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
