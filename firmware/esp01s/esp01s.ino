/*
 * dsh-stm32-toolchain - ESP-01S (ESP8266) Wi-Fi bridge for STM32 UART flashing
 *
 * Two TCP servers (always available once the ESP has a network):
 *   CTRL_PORT (3333) - line based control: BOOT0 / NRST / reset pulses / status / wifi
 *   PIPE_PORT (3334) - raw bidirectional pipe to UART0 = the STM32 USART (115200 8N1)
 *
 * Wi-Fi credentials, in priority order:
 *   1. EEPROM        - saved by the provisioning page (survives reboot AND a normal reflash)
 *   2. wifi_creds.h  - generated by the plugin ("生成固件" bakes SSID/password in)
 *   3. provisioning  - neither works: start an AP + config page (network setup, not a fallback LAN)
 *
 * Wiring (ESP-01S is 3.3 V only):
 *   ESP TX  -> STM32 USART RX (PA10 on F411 / F407 USART1)
 *   ESP RX  -> STM32 USART TX (PA9)
 *   GND     -> common ground
 *   3V3     -> 3V3 rail (>= 300 mA, 100 uF close to the module)
 *   GPIO2   -> STM32 BOOT0
 *   GPIO0   -> STM32 NRST   (10k pull-up mandatory: GPIO0 must be HIGH at boot)
 *
 * The ESP never prints to UART0 except transparent payload: debug text goes to the
 * CTRL socket, so the pipe stays byte clean for AN3155.
 */

#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <DNSServer.h>
#include <EEPROM.h>
#include <stdarg.h>

#if __has_include("wifi_creds.h")
#include "wifi_creds.h"          /* written by the plugin: #define WIFI_SSID / WIFI_PASS */
#endif
#ifndef WIFI_SSID
#define WIFI_SSID ""
#endif
#ifndef WIFI_PASS
#define WIFI_PASS ""
#endif

/* ------------------------- fixed configuration ------------------------- */
#define AP_SSID          "STM32-ESP01S"   /* provisioning access point */
#define AP_PASS          "stm32flash"
#define STA_TIMEOUT_MS   15000

/* Board selection. ESP-12E / NodeMCU is the recommended carrier: its own USB and
 * 3.3 V regulator make it far more tolerant than a bare ESP-01S, and D1/D2 carry no
 * boot strap, so driving the STM32 from them cannot put the ESP in flash mode. */
#ifndef BOARD_NODEMCU
#define BOARD_NODEMCU    1                /* 1 = ESP-12E/NodeMCU, 0 = ESP-01S */
#endif

#if BOARD_NODEMCU
#define PIN_BOOT0        4                /* D2 -> STM32 BOOT0 */
#define PIN_NRST         5                /* D1 -> STM32 NRST  */
#else
#define PIN_BOOT0        2                /* GPIO2 -> BOOT0 */
#define PIN_NRST         0                /* GPIO0 -> NRST  */
#endif
#ifndef PIPE_BAUD
#define PIPE_BAUD        115200       /* 生成固件时由插件写入（wifi_creds.h）；也可 -D 覆盖 */
#endif
#define CTRL_PORT        3333
#define PIPE_PORT        3334
#define PULSE_MS_DEFAULT 100
#define BOOT_SETTLE_MS   30           /* BOOT0 必须先稳住，再给复位沿 */
#define RESET_PULSE_MS   200          /* 复位低电平时间 */
#define BOOT_POST_MS     50           /* 释放后等芯片起来 */

/* ESP GPIO0 drives NRST but is ALSO the ESP's own flash-mode strap: at power-up the
 * STM32 holds NRST low (its reset circuit), which can make the ESP sample GPIO0 low
 * and boot into UART download mode - completely silent, no AP. Two defences:
 *   1. hardware: put a diode between them (anode NRST, cathode GPIO0) + 10k pull-up
 *      on GPIO0, so the STM32 can never drag GPIO0 down;
 *   2. firmware: once we are running, drive BOOT0 low and pulse NRST so the STM32
 *      re-samples a correct boot mode instead of sitting in the bootloader. */
#define SELF_SYNC_STM32 1

/* How GPIO0 drives NRST:
 *   0 = direct wire (GPIO0 low = reset). Needs a diode so the STM32 cannot drag the
 *       ESP strap low at power-up.
 *   1 = open-collector stage: GPIO0 -> 1k -> base(NPN) or gate(N-MOS), emitter/source
 *       to GND, collector/drain to NRST. GPIO0 high = reset. No shared net, so the
 *       strap hazard disappears and a plain NPN/MOSFET is enough (no diode needed). */
#define NRST_INVERTED 0
/* ---------------------------------------------------------------------- */

struct WifiCreds {
  uint32_t magic;
  char     ssid[33];
  char     pass[65];
};
#define CREDS_MAGIC 0x32534457u   /* "WDS2" */

static WifiCreds s_creds;
static const char *s_wifiSrc = "none";      /* flash | build | ap */
static bool s_provisioning = false;
static int  s_lastStaStatus = 0;            /* wl_status_t of the last failed join */
static char s_triedSsid[33] = "";

WiFiServer ctrlServer(CTRL_PORT);
WiFiServer pipeServer(PIPE_PORT);
WiFiClient ctrlClient;
WiFiClient pipeClient;
ESP8266WebServer web(80);
DNSServer dns;

static uint32_t ctrlCount = 0;
static uint32_t pipeBytesDown = 0;
static uint32_t pipeBytesUp = 0;

/* ------------------------------ helpers ------------------------------- */
static bool credsValid(void)
{
  return s_creds.magic == CREDS_MAGIC && s_creds.ssid[0] != '\0';
}

static void credsLoad(void)
{
  EEPROM.begin(sizeof(WifiCreds));
  EEPROM.get(0, s_creds);
  if (!credsValid()) memset(&s_creds, 0, sizeof(s_creds));
}

static void credsSave(const char *ssid, const char *pass)
{
  memset(&s_creds, 0, sizeof(s_creds));
  s_creds.magic = CREDS_MAGIC;
  strncpy(s_creds.ssid, ssid, sizeof(s_creds.ssid) - 1);
  strncpy(s_creds.pass, pass, sizeof(s_creds.pass) - 1);
  EEPROM.put(0, s_creds);
  EEPROM.commit();
}

static void credsClear(void)
{
  memset(&s_creds, 0, sizeof(s_creds));
  EEPROM.put(0, s_creds);
  EEPROM.commit();
}

/** Returns String: WiFi.SSID() is a temporary, so its c_str() must not outlive the call. */
static String activeSsid(void)
{
  if (s_provisioning) return String(AP_SSID);
  String ssid = WiFi.SSID();
  return ssid.length() > 0 ? ssid : String("none");
}

static String ipString(void)
{
  if (s_provisioning) return WiFi.softAPIP().toString();
  return WiFi.localIP().toString();
}

static void boot0Set(int level) { digitalWrite(PIN_BOOT0, level ? HIGH : LOW); }

/** level 1 = reset released, 0 = reset asserted. */
static void nrstSet(int level)
{
#if NRST_INVERTED
  digitalWrite(PIN_NRST, level ? LOW : HIGH);   /* transistor on = reset asserted */
#else
  digitalWrite(PIN_NRST, level ? HIGH : LOW);
#endif
}

static void nrstPulse(uint32_t ms)
{
  nrstSet(0);
  delay(ms);
  nrstSet(1);
}

static void ctrlPrintf(const char *fmt, ...)
{
  if (!ctrlClient || !ctrlClient.connected()) return;
  char buf[192];
  va_list ap;
  va_start(ap, fmt);
  vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);
  ctrlClient.print(buf);
}

static void banner(void)
{
  ctrlPrintf("+READY mode=%s src=%s ssid=%s ip=%s boot0=%d nrst=%d baud=%d pipe=%d\r\n",
             s_provisioning ? "ap" : "sta", s_wifiSrc, activeSsid().c_str(), ipString().c_str(),
             digitalRead(PIN_BOOT0), digitalRead(PIN_NRST), PIPE_BAUD, PIPE_PORT);
  if (s_provisioning && s_lastStaStatus != 0) {
    ctrlPrintf("+LASTSTA tried=%s status=%d %s\r\n", s_triedSsid, s_lastStaStatus, staReason(s_lastStaStatus));
  }
}

/* ---------------------------- provisioning ---------------------------- */
static void provisioningPage(void)
{
  String ssidArg = web.arg("ssid");
  String html =
    "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
    "<title>STM32 无线配网</title>"
    "<body style='font-family:system-ui;max-width:22rem;margin:2rem auto;padding:0 1rem'>"
    "<h2>STM32 无线配网</h2>"
    "<p style='color:#666;font-size:.9rem'>填入这台机器人要连的 Wi-Fi，保存后自动重启连接。</p>"
    "<form method='POST' action='/save'>"
    "<label>Wi-Fi 名称</label><br><input name=ssid value='" + ssidArg + "' style='width:100%;padding:.5rem;margin:.3rem 0 1rem'>"
    "<label>Wi-Fi 密码</label><br><input name=pass type=password style='width:100%;padding:.5rem;margin:.3rem 0 1.2rem'>"
    "<button style='width:100%;padding:.6rem;font-size:1rem'>保存并连接</button></form>"
    "<p style='color:#999;font-size:.8rem;margin-top:1.5rem'>当前来源: " + String(s_wifiSrc) +
    (s_lastStaStatus ? "<br>上次连接 " + String(s_triedSsid) + " 失败: " + String(s_lastStaStatus) + " (" + String(staReason(s_lastStaStatus)) + ")" : "") +
    "</p></body>";
  web.send(200, "text/html; charset=utf-8", html);
}

static void startProvisioning(void)
{
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  dns.setErrorReplyCode(DNSReplyCode::NoError);
  dns.start(53, "*", WiFi.softAPIP());

  web.on("/", provisioningPage);
  web.on("/save", []() {
    String ssid = web.arg("ssid");
    String pass = web.arg("pass");
    if (ssid.length() == 0) {
      web.send(400, "text/plain; charset=utf-8", "SSID 不能为空");
      return;
    }
    credsSave(ssid.c_str(), pass.c_str());
    web.send(200, "text/plain; charset=utf-8", "已保存，正在重启并连接 " + ssid);
    delay(1200);
    ESP.restart();
  });
  web.onNotFound([]() {
    web.sendHeader("Location", "http://192.168.4.1/", true);
    web.send(302, "text/plain", "");
  });
  web.begin();
  s_provisioning = true;
  s_wifiSrc = "ap";
}

/** Plain-language reason, so the provisioning page can tell "5 GHz" from "wrong password". */
static const char *staReason(int status)
{
  switch (status) {
    case 0:  return "idle";
    case 1:  return "no-ssid (2.4GHz? name? in range?)";
    case 3:  return "connected";
    case 4:  return "connect-failed";
    case 5:  return "connection-lost";
    case 6:  return "wrong-password";
    default: return "disconnected";
  }
}

static bool joinWifi(const char *ssid, const char *pass, uint32_t timeoutMs)
{
  if (ssid == NULL || ssid[0] == '\0') return false;
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(ssid, pass);
  strncpy(s_triedSsid, ssid, sizeof(s_triedSsid) - 1);
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < timeoutMs) delay(150);
  s_lastStaStatus = (int)WiFi.status();
  return WiFi.status() == WL_CONNECTED;
}

/* ----------------------------- control -------------------------------- */
static void handleCommand(String line)
{
  line.trim();
  if (line.length() == 0) return;
  ctrlCount++;

  if (line.equalsIgnoreCase("PING")) {
    ctrlPrintf("+PONG %lu\r\n", (unsigned long)millis());
    return;
  }
  if (line.startsWith("BOOT ")) {
    int v = line.substring(5).toInt() ? 1 : 0;
    boot0Set(v);
    ctrlPrintf("+BOOT %d\r\n", v);
    return;
  }
  if (line.startsWith("NRST ")) {
    int v = line.substring(5).toInt() ? 1 : 0;
    nrstSet(v);
    ctrlPrintf("+NRST %d\r\n", v);
    return;
  }
  if (line.startsWith("PULSE")) {
    uint32_t ms = (line.length() > 5) ? (uint32_t)line.substring(6).toInt() : PULSE_MS_DEFAULT;
    if (ms < 20) ms = 20;
    if (ms > 2000) ms = 2000;
    nrstPulse(ms);
    ctrlPrintf("+PULSE %lu\r\n", (unsigned long)ms);
    return;
  }
  if (line.equalsIgnoreCase("BOOTLOADER")) {
    boot0Set(1);
    delay(BOOT_SETTLE_MS);
    nrstPulse(RESET_PULSE_MS);
    delay(BOOT_POST_MS);
    /* Read the pin back: 0 here means the wire to BOOT0 is not actually connected. */
    ctrlPrintf("+BOOTLOADER boot0=%d\r\n", digitalRead(PIN_BOOT0));
    return;
  }
  if (line.equalsIgnoreCase("RUN")) {
    boot0Set(0);
    nrstPulse(PULSE_MS_DEFAULT);
    ctrlPrintf("+RUN\r\n");
    return;
  }
  if (line.equalsIgnoreCase("WIFI")) {
    ctrlPrintf("+WIFI mode=%s src=%s ssid=%s ip=%s rssi=%d haveSaved=%d tried=%s last=%d:%s\r\n",
               s_provisioning ? "ap" : "sta", s_wifiSrc, activeSsid().c_str(), ipString().c_str(),
               s_provisioning ? 0 : WiFi.RSSI(), credsValid() ? 1 : 0,
               s_triedSsid, s_lastStaStatus, staReason(s_lastStaStatus));
    return;
  }
  if (line.equalsIgnoreCase("RESETWIFI")) {
    credsClear();
    ctrlPrintf("+RESETWIFI saved credentials cleared, restarting into provisioning\r\n");
    delay(200);
    ESP.restart();
  }
  if (line.equalsIgnoreCase("STATUS")) {
    ctrlPrintf("+STATUS mode=%s src=%s ssid=%s ip=%s rssi=%d boot0=%d nrst=%d pipe=%s cmds=%lu rx=%lu tx=%lu up=%lu\r\n",
               s_provisioning ? "ap" : "sta", s_wifiSrc, activeSsid().c_str(), ipString().c_str(),
               s_provisioning ? 0 : WiFi.RSSI(),
               digitalRead(PIN_BOOT0), digitalRead(PIN_NRST),
               (pipeClient && pipeClient.connected()) ? "on" : "off",
               (unsigned long)ctrlCount, (unsigned long)pipeBytesDown,
               (unsigned long)pipeBytesUp, (unsigned long)(millis() / 1000));
    return;
  }
  if (line.equalsIgnoreCase("REBOOT")) {
    ctrlPrintf("+REBOOT\r\n");
    delay(50);
    ESP.restart();
  }
  ctrlPrintf("+ERR unknown\r\n");
}

/* ------------------------------- main --------------------------------- */
void setup()
{
  Serial.setRxBufferSize(1024);
  Serial.begin(PIPE_BAUD);
  Serial.setDebugOutput(false);

  pinMode(PIN_BOOT0, OUTPUT);
  pinMode(PIN_NRST, OUTPUT);
  boot0Set(0);
  nrstSet(1);

  WiFi.persistent(false);
  WiFi.setSleepMode(WIFI_NONE_SLEEP);   /* modem sleep stalls TCP sessions on this chip */
  credsLoad();

  bool ok = false;
  if (credsValid()) {
    ok = joinWifi(s_creds.ssid, s_creds.pass, STA_TIMEOUT_MS);
    if (ok) s_wifiSrc = "flash";
  }
  if (!ok && strlen(WIFI_SSID) > 0) {
    ok = joinWifi(WIFI_SSID, WIFI_PASS, STA_TIMEOUT_MS);
    if (ok) s_wifiSrc = "build";
  }
  if (!ok) startProvisioning();

  /* Both chips may have powered up together, with the STM32 stuck in its bootloader
   * because GPIO2 (BOOT0) was high while the ESP was booting. Put BOOT0 low and give
   * the STM32 one clean reset so it starts the application. */
#if SELF_SYNC_STM32
  boot0Set(0);
  delay(20);
  nrstPulse(60);
#endif

  ctrlServer.begin();
  ctrlServer.setNoDelay(true);
  pipeServer.begin();
  pipeServer.setNoDelay(true);
}

void loop()
{
  if (s_provisioning) {
    dns.processNextRequest();
    web.handleClient();
    if (WiFi.getMode() == WIFI_STA) s_provisioning = false;   /* saved + rebooted */
  }

  if (ctrlClient && !ctrlClient.connected()) {
    ctrlClient.stop();
  }
  if (!ctrlClient || !ctrlClient.connected()) {
    WiFiClient fresh = ctrlServer.available();
    if (fresh) {
      ctrlClient = fresh;
      ctrlClient.setNoDelay(true);
      banner();
    }
  }
  if (pipeClient && !pipeClient.connected()) {
    pipeClient.stop();
  }
  if (!pipeClient || !pipeClient.connected()) {
    WiFiClient fresh = pipeServer.available();
    if (fresh) {
      pipeClient = fresh;
      pipeClient.setNoDelay(true);
      while (Serial.available()) Serial.read();
    }
  }

  if (ctrlClient && ctrlClient.connected()) {
    while (ctrlClient.available()) {
      String line = ctrlClient.readStringUntil('\n');
      handleCommand(line);
    }
  }

  if (pipeClient && pipeClient.connected()) {
    uint8_t buf[128];
    size_t n = 0;
    while (pipeClient.available() && n < sizeof(buf)) buf[n++] = (uint8_t)pipeClient.read();
    if (n > 0) {
      Serial.write(buf, n);
      Serial.flush();
      pipeBytesDown += n;
    }
    n = 0;
    while (Serial.available() && n < sizeof(buf)) buf[n++] = (uint8_t)Serial.read();
    if (n > 0) {
      pipeClient.write(buf, n);
      pipeBytesUp += n;
    }
  }
  yield();
}
